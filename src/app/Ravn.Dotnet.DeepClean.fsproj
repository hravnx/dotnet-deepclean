<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>DeepClean</AssemblyName>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PackAsTool>true</PackAsTool>
    <PackageId>Ravn.Dotnet.DeepClean</PackageId>
    <ToolCommandName>dotnet-deepclean</ToolCommandName>
    <Version>0.2.0</Version>
    <PackageVersion>$(Version)</PackageVersion>
    <Authors>Henrik Ravn</Authors>
    <Description>Command-line tool for really cleaning .NET project directories.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="DeepClean.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Argu" Version="6.2.5" />
    <None Include="../../README.md" Pack="true" PackagePath="\" Link="README.md" />
  </ItemGroup>

</Project>
